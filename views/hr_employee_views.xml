<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="view_hr_employee_form_inherit_veterinarian_management" model="ir.ui.view">
            <field name="name">hr.employee.form.inherit.veterinarian.management</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook/page[@name='work_information']//field[@name='job_id']" position="after">
                    <field name="is_veterinarian"/>
                </xpath>
            </field>
        </record>

        <record id="action_hr_employee_veterinarians" model="ir.actions.act_window">
            <field name="name">Veterinarians</field>
            <field name="res_model">hr.employee</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="domain">[('is_veterinarian','=',True)]</field>
        </record>
    </data>
</odoo>