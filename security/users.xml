<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="1">

        <record model="ir.module.category" id="module_category_veterinary_management">
            <field name="name">Veterinary</field>
            <field name="sequence">1</field>
        </record>

        <record model="res.groups.privilege" id="res_groups_privilege_veterinary_management">
            <field name="name">Veterinary</field>
            <field name="category_id" ref="module_category_veterinary_management"/>
            <field name="sequence">7</field>
        </record>

        <!-- User group -->
        <record id="group_veterinary_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="res_groups_privilege_veterinary_management"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- veterinarian group -->
        <record id="group_veterinarian" model="res.groups">
            <field name="name">Veterinarian</field>
            <field name="privilege_id" ref="res_groups_privilege_veterinary_management"/>
            <field name="implied_ids" eval="[(4, ref('group_veterinary_user'))]"/>
        </record>

        <!-- administrator group -->
        <record id="group_veterinary_administrator" model="res.groups">
            <field name="name">Administrator</field>
            <field name="privilege_id" ref="res_groups_privilege_veterinary_management"/>
            <field name="implied_ids" eval="[(4, ref('group_veterinarian'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

    </data>
</odoo>

